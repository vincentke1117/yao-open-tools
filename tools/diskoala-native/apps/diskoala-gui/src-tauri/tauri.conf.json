{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Diskoala",
  "version": "2.0.0-alpha.1",
  "identifier": "com.kodingstudio.diskoala",
  "build": {
    "frontendDist": "../web-app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Diskoala 磁盘考拉 · 磁盘空间清理顾问",
        "width": 1120,
        "height": 720,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/logo.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
